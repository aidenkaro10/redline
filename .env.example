# Copy this file to .env and fill in real values. Never commit .env.

# Pulsoid access token (from pulsoid.net, used for live Apple Watch heart rate)
PULSOID_TOKEN=

# Job site location for NWS weather alerts. Default: Gainesville, FL
JOB_SITE_LAT=29.6516
JOB_SITE_LON=-82.3248

# NWS asks for a User-Agent with contact info
NWS_USER_AGENT=planit-control (your-email@example.com)

# USB serial port for the band (find it with: ls /dev/cu.*)
SERIAL_PORT=/dev/cu.usbmodem1101

# Which worker the real band + watch belong to
WORKER_ID=worker-1

# Port the band sends WiFi (UDP) lines to
UDP_PORT=5005

# Claude API key for the planning agent (console.anthropic.com)
ANTHROPIC_API_KEY=

# --- Emergency escalation (backend/emergency/) ---
# The ONLY numbers the system may call. Full format with country code, e.g. +13525551234.
# 911 and other emergency numbers are always refused, even if you put them here.
CREW_LEAD_NUMBER=
SAFETY_OFFICER_NUMBER=
# A teammate's phone that plays the 911 dispatcher in the demo
EMERGENCY_TEST_NUMBER=
# 0 = dry run (prints the call script, no phone rings). 1 = really place calls.
EMERGENCY_LIVE_CALLS=0
# ElevenLabs voice agent for live calls (elevenlabs.io > Agents). Only used when EMERGENCY_LIVE_CALLS=1.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# From elevenlabs.io > Agents > Phone Numbers, after importing the Twilio number
ELEVENLABS_PHONE_NUMBER_ID=
