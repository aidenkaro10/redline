{
  "name": "planit-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-figures.mjs",
    "dev": "next dev",
    "dev:real": "NEXT_DIST_DIR=.next-real NEXT_PUBLIC_BACKEND_URL=${BACKEND_URL:-http://localhost:8000} next dev",
    "prebuild": "node scripts/copy-figures.mjs",
    "build": "next build",
    "start": "next start",
    "test": "node --import ./src/test/register.mjs --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "next typegen && tsc --noEmit && npm test && npm run build"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "1.3.27",
    "next": "16.4.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9"
  }
}
